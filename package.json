{
  "name": "somora",
  "version": "2026.1001.4",
  "description": "A self-hosted multi-agent harness: your agents, your models, one server — with memory, a shared wiki, a web desktop, a phone app and a terminal client.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://somora.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenaxon/somora_agent.git"
  },
  "bugs": {
    "url": "https://github.com/thenaxon/somora_agent/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "llm",
    "claude",
    "codex",
    "openai-compatible",
    "self-hosted",
    "memory",
    "wiki"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "somora": "bin/somora.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "templates",
    "config.example.yaml",
    "web/dist",
    "web-mobile/dist",
    "tsconfig.json",
    "package.json",
    "README.md",
    "LICENSE",
    "!src/**/*.test.mts",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "tsx src/server/index.ts",
    "dev:cli": "tsx src/cli/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:fast": "npm run typecheck && npm test",
    "build:web": "cd web && npm ci && npm run build",
    "build:mobile": "cd web-mobile && npm ci && npm run build",
    "build:all": "npm run build:web && npm run build:mobile",
    "prepack": "npm run build:all"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.152",
    "@anthropic-ai/sdk": "^0.99.0",
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@openai/codex": "0.153.4",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.17",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "node-pty": "^1.1.0",
    "openai": "^6.39.0",
    "pdf-to-img": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.5",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.17.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "undici": "^7.25.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/ssh2": "^1.15.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  }
}

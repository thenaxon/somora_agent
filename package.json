{
  "name": "somora",
  "version": "2026.1010.2",
  "description": "A self-hosted multi-agent harness: your agents, your models, one server — with memory, a shared wiki, a web desktop, a phone app and a terminal client.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://somora.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenaxon/somora_agent.git"
  },
  "bugs": {
    "url": "https://github.com/thenaxon/somora_agent/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "llm",
    "claude",
    "codex",
    "openai-compatible",
    "self-hosted",
    "memory",
    "wiki"
  ],
  "publishConfig": {
    "access": "public"
  },
  "somora": {
    "glibc": "2.34",
    "lastForOlderGlibc": "2026.1007.2"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "somora": "bin/somora.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "templates",
    "config.example.yaml",
    "web/dist",
    "web-mobile/dist",
    "tsconfig.json",
    "package.json",
    "README.md",
    "LICENSE",
    "!src/**/*.test.mts",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "preinstall": "node bin/preinstall-check.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "tsx src/server/index.ts",
    "dev:cli": "tsx src/cli/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify:fast": "npm run typecheck && npm test",
    "build:web": "cd web && npm ci && npm run build",
    "build:mobile": "cd web-mobile && npm ci && npm run build",
    "build:all": "npm run build:web && npm run build:mobile",
    "prepack": "npm run build:all"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@anthropic-ai/sdk": "^0.132.1",
    "@hono/node-server": "2.1.4",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@openai/codex": "0.161.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "4.13.13",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "node-pty": "^1.1.0",
    "openai": "^7.30.1",
    "pdf-to-img": "^7.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "sharp": "^0.35.5",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@xai-official/grok-darwin-arm64": "1.0.46",
    "@xai-official/grok-darwin-x64": "1.0.46",
    "@xai-official/grok-linux-arm64": "1.0.46",
    "@xai-official/grok-linux-x64": "1.0.46"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "~22.20.5",
    "@types/react": "^19.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}

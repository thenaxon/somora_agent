    "docs",
    "tsconfig.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "tsx src/server/index.ts",
    "dev:cli": "tsx src/cli/tui/index.tsx",
    "typecheck": "tsc --noEmit"
  },

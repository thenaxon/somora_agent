    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.17",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "node-pty": "^1.1.0",

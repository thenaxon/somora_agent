{
  "name": "somora",
  "version": "2026.05.09.6",
  "private": true,
  "type": "module",
  "description": "Local-first gateway for personal AI agents with persistent memory across multiple LLM providers",
  "engines": {
    "node": ">=20"
  },
  "bin": {
